# Copy to server/.env before the FIRST start, then edit.
PORT=3001

# Signs login tokens. Change it — anything long and random.
JWT_SECRET=replace-this-with-a-long-random-string

# Bootstrap admin, created only when the database is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Admin

CURRENCY=ل.س

# --- air-gapped deployment -------------------------------------------------

# The address used in the join QR code and the wall-display link.
#
# Left unset, the app picks the best-looking LAN address it can find, skipping
# VPN tunnels and virtual switches. Set it explicitly once the machine has its
# static IP: a QR code that encodes an unreachable address is the kind of
# failure nobody on site can diagnose.
#
# PUBLIC_HOST=192.168.1.50

# Automatic database snapshots (VACUUM INTO, safe while running).
# BACKUP_INTERVAL_HOURS=6
# BACKUP_KEEP=14

# Where the database, menu photos and backups live. Resolved to an absolute
# path. Only set this if you have a reason — a Windows service starts in
# C:\Windows\System32, and a relative path there creates a database nobody
# can find.
# DATA_DIR=C:\office-order\data
